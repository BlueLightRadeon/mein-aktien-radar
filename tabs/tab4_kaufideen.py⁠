import streamlit as st
from groq import Groq
from data_service import fetch_all_headlines
from ai_service import run_buy_recommendations_analysis

def render(portfolio_list, selected_model, groq_key, get_berlin_time_str):
    st.info("ℹ️ **Kurzinfo:** KI-Ratgeber zur Portfolio-Erweiterung: 5 konkrete Top-Aktien basierend auf der aktuellen Welt- und Marktlage.")
    
    # Button ganz oben im Blickfeld
    col_btn, col_time = st.columns([2, 2])
    with col_btn:
        btn_ideas = st.button("🎯 Top 5 Kaufempfehlungen jetzt berechnen", type="primary", key="btn_eval_ideas", width="stretch")
    with col_time:
        ideas_time = st.session_state.get("last_ideas_time", "")
        if ideas_time:
            st.caption(f"🕒 Stand: **{ideas_time}**")

    # Direkte Berechnung & Anzeige ohne Tab-Sprung
    if btn_ideas:
        if not groq_key:
            st.error("⚠️ Bitte hinterlege deinen GROQ_API_KEY in den Secrets.")
        else:
            with st.spinner("Recherchiere die 5 besten Zukäufe außerhalb deines Depots..."):
                try:
                    client = Groq(api_key=groq_key)
                    headlines = fetch_all_headlines()
                    news_text = "\n".join(headlines) if headlines else "Stabile Weltwirtschaftslage."
                    
                    existing_names = [item.get("name", item.get("ticker", "")) for item in portfolio_list]
                    existing_str = ", ".join(existing_names) if existing_names else "Keine"

                    ideas_report = run_buy_recommendations_analysis(client, selected_model, existing_str, news_text)
                    st.session_state["ai_signals"] = ideas_report
                    st.session_state["last_ideas_time"] = get_berlin_time_str()
                    st.success("✅ Top 5 Kaufempfehlungen erfolgreich berechnet!")
                except Exception as e:
                    st.error(f"Fehler bei den Kaufempfehlungen: {e}")

    # Text wird direkt darunter gerendert
    signals_text = st.session_state.get("ai_signals", "")
    if signals_text and len(signals_text.strip()) > 15:
        st.divider()
        st.markdown(signals_text)
    elif not btn_ideas:
        st.info("Klicke oben auf '🎯 Top 5 Kaufempfehlungen jetzt berechnen', um Investment-Ideen zu laden.")
